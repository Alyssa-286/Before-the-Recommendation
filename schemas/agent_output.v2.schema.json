{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://before-the-recommendation.invalid/schemas/agent_output.v2.schema.json",
  "x-schema-version": "2.0.0",
  "title": "Before the Recommendation model-owned recommendation",
  "description": "Model-owned final output only. Tool protocol and controller-inserted clarification fields are recorded separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["preference_weights", "ranked_products", "evidence_used", "uncertainty", "final_explanation"],
  "properties": {
    "preference_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "quality", "durability", "sustainability"],
      "properties": {
        "price": {"type": "number", "minimum": 0, "maximum": 1},
        "quality": {"type": "number", "minimum": 0, "maximum": 1},
        "durability": {"type": "number", "minimum": 0, "maximum": 1},
        "sustainability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ranked_products": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_used": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "final_explanation": {"type": "string", "minLength": 1}
  }
}
